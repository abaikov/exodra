#!/bin/sh
# A commit goes through only for a tree `npm run release:check:clean` passed. If this exact tree has
# not passed yet, the hook runs the clean check itself (build output removed, npm ci, every check).
root="$(git rev-parse --show-toplevel)"
stamp="$root/.release-check-pass"
if [ -n "$(git diff --name-only)" ] || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "✖ commit refused: there are changes that are not staged. The clean check covers the whole tree — git add -A (or stash the rest) and commit again." >&2
    exit 1
fi
tree="$(git write-tree)"
if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$tree" ]; then
    exit 0
fi
echo "▶ this tree has not passed the clean check yet — running npm run release:check:clean (about 6 minutes)…"
(cd "$root" && env -u GIT_INDEX_FILE npm run release:check:clean) || exit 1
if [ "$(cat "$stamp" 2>/dev/null)" != "$tree" ]; then
    echo "✖ commit refused: the clean check passed a different tree than the one staged. Stage everything and commit again." >&2
    exit 1
fi
exit 0
