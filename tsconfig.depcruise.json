{
    // Resolution map for the ARCHITECTURE CRAWL only (`npm run graph*`), never for a build. A
    // specifier that does not resolve through `paths` lands in node_modules and its edge silently
    // vanishes from rules and diagram alike — so each key must be a spelling the package really
    // exports, and `extends` REPLACES `paths` whole rather than merging key by key. The root config
    // cannot hold them: it resolves siblings to `dist/*.d.ts`; aiming those at source breaks TS6059.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@exodra/context": ["./packages/context/src/index.ts"],
            "@exodra/core": ["./packages/core/src/index.ts"],
            "@exodra/computed": ["./packages/computed/src/index.ts"],
            "@exodra/list-reconcile": ["./packages/list-reconcile/src/index.ts"],
            "@exodra/router": ["./packages/router/src/index.ts"],
            "@exodra/dom": ["./packages/dom/src/index.ts"],
            "@exodra/string": ["./packages/string/src/index.ts"],
            "@exodra/ssr": ["./packages/ssr/src/index.ts"],
            "@exodra/jsx": ["./packages/jsx/src/schema/index.ts"],
            "@exodra/jsx/schema": ["./packages/jsx/src/schema/index.ts"],
            "@exodra/jsx/schema/jsx-runtime": ["./packages/jsx/src/schema/jsx-runtime.ts"],
            "@exodra/jsx/schema/jsx-dev-runtime": ["./packages/jsx/src/schema/jsx-dev-runtime.ts"],
            "@exodra/forms": ["./packages/forms/src/index.ts"],
            "@exodra/react": ["./packages/react/src/index.ts"],
            "@exodra/react-mount": ["./packages/react-mount/src/index.ts"],
            "@exodra/babel-plugin-schema": ["./packages/babel-plugin-exodra-schema/src/index.ts"],
            "@exodra/vite-plugin": ["./packages/vite-plugin-exodra/src/index.ts"],
            "@exodra/introspect": ["./packages/introspect/src/index.ts"],
            "@exodra/dom-profiler": ["./packages/dom-profiler/src/index.ts"],
            // A MAPPING, NOT A package.json ENTRY, for the three private packages below: reached through
            // a Vite/vitest alias, so a declared dependency would assert an install relationship that
            // does not exist. Mapped, the edge is typed `local`; unmapped, it is `not-to-unresolvable`.
            "@exodra/term": ["./packages/term/src/index.ts"],
            "@exodra/conformance": ["./packages/conformance/src/index.ts"],
            "@exodra/test-utils": ["./packages/test-utils/src/index.ts"],
            "@exodra/bench-harness": ["./packages/bench-harness/src/index.ts"]
        }
    }
}
