{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false,
    "rootDir": "..",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@exodra/core": ["../core/.tsbuild/index.d.ts"],
      "@exodra/list-reconcile": ["../list-reconcile/.tsbuild/index.d.ts"],
      "@exodra/dom": ["../dom/.tsbuild/index.d.ts"],
      "@exodra/reactivity": ["../reactivity/.tsbuild/index.d.ts"],
      "@exodra/reactivity-types": ["../reactivity-types/.tsbuild/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "types/**/*.ts", "../babel-plugin-exodra-schema/types/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
