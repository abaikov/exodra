{
  "name": "@exodra/ssr",
  "version": "0.3.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "find src -name '*.js' -o -name '*.d.ts' -o -name '*.js.map' -o -name '*.d.ts.map' | xargs rm -f 2>/dev/null || true",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist .tsbuild tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "description": "Server-side rendering for Exodra - the full HTML document, the HTTP status, the response headers, the <head>, and state transfer to the client",
  "keywords": [
    "exodra",
    "ssr",
    "server-side-rendering",
    "seo",
    "meta-tags",
    "head-management",
    "hydration",
    "node",
    "typescript",
    "performance"
  ],
  "author": "Andrei Baikov",
  "license": "MIT",
  "homepage": "https://exodra.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/exodra.git",
    "directory": "packages/ssr"
  },
  "bugs": {
    "url": "https://github.com/abaikov/exodra/issues"
  },
  "devDependencies": {
    "@exodra/dom": "^0.3.0",
    "@exodra/list-reconcile": "^0.3.0",
    "jsdom": "^23.0.1",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "@exodra/context": "^0.3.0",
    "@exodra/core": "^0.3.0",
    "@exodra/string": "^0.4.1"
  }
}
