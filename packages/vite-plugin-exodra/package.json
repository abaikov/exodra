{
  "name": "@exodra/vite-plugin",
  "version": "0.4.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "babel-preset-exodra": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@exodra/core": "^0.4.0",
    "@exodra/router": "^0.4.0",
    "vite": "^7.3.7"
  },
  "description": "Vite plugin for Exodra - file-based routing, HMR, optimized builds, and Next.js-like developer experience",
  "keywords": [
    "exodra",
    "vite",
    "vite-plugin",
    "hmr",
    "hot-reload",
    "file-based-routing",
    "nextjs",
    "dev-server",
    "build-tool",
    "bundler",
    "typescript",
    "jsx"
  ],
  "author": "Andrei Baikov",
  "license": "MIT",
  "homepage": "https://exodra.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/exodra.git",
    "directory": "packages/vite-plugin-exodra"
  },
  "bugs": {
    "url": "https://github.com/abaikov/exodra/issues"
  }
}
