{
  "name": "@exodra/core",
  "version": "0.4.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/exodra.global.js",
  "jsdelivr": "./dist/exodra.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style": {
      "types": "./dist/style/index.d.ts",
      "import": "./dist/style/index.js",
      "require": "./dist/style/index.cjs"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/exodra.esm.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "find src -name '*.js' -o -name '*.d.ts' -o -name '*.js.map' -o -name '*.d.ts.map' | xargs rm -f 2>/dev/null || true",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist .tsbuild tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:property-kind": "tsx bench/attr/exoPropertyKindBench.ts"
  },
  "description": "Core component system for Exodra - the backend-agnostic schema, ports and wiring of a fine-grained reactive renderer",
  "keywords": [
    "exodra",
    "web-framework",
    "reactive",
    "reactivity",
    "ui-framework",
    "frontend",
    "component",
    "fine-grained",
    "performance",
    "typescript",
    "vdom-alternative"
  ],
  "author": "Andrei Baikov",
  "license": "MIT",
  "homepage": "https://exodra.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/exodra.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/abaikov/exodra/issues"
  },
  "peerDependencies": {
    "@exodra/context": "^0.3.0"
  },
  "devDependencies": {
    "@exodra/bench-harness": "*",
    "vitest": "^4.0.16"
  }
}
