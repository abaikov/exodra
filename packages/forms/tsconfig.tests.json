{
  // THE TEST FILES OF `@exodra/forms`, COMPILED. The scheme is written out once in
  // `packages/core/tsconfig.tests.json`.
  //
  // `paths` restated in full (`extends` replaces it, never merges). The first entry is the
  // base's; the four added are all test-only: the suite renders controls through `@exodra/dom`,
  // checks the server's spelling of the same control through `@exodra/string`, and takes its host
  // from `@exodra/test-utils`. `@exodra/reactivity-types` is mapped because both backends'
  // declarations name it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false,
    "baseUrl": ".",
    "paths": {
      "@exodra/core": ["../core/.tsbuild/index.d.ts"],
      "@exodra/dom": ["../dom/.tsbuild/index.d.ts"],
      "@exodra/string": ["../string/.tsbuild/index.d.ts"],
      "@exodra/reactivity-types": ["../reactivity-types/.tsbuild/index.d.ts"],
      "@exodra/test-utils": ["../test-utils/.tsbuild/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", ".tsbuild", "node_modules"]
}
