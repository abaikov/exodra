{
  "name": "@exodra/forms",
  "version": "0.4.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/exodra.global.js",
  "jsdelivr": "./dist/exodra.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/exodra.esm.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@exodra/core": "^0.4.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist .tsbuild tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Andrei Baikov",
  "license": "MIT",
  "description": "Form controls for Exodra without a bound model: read any control off an event target or a ref port, and move a radio or option mark in two writes",
  "homepage": "https://exodra.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/exodra.git",
    "directory": "packages/forms"
  },
  "bugs": {
    "url": "https://github.com/abaikov/exodra/issues"
  },
  "keywords": [
    "exodra",
    "forms",
    "form-controls"
  ],
  "devDependencies": {
    "vitest": "^4.0.16"
  }
}
