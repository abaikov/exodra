{
  "name": "@exodra/babel-plugin-schema",
  "version": "0.2.0",
  "description": "Babel plugins that compile JSX into Exodra schemas: exoJsx(($) => <markup/>) declarations into createExoNamedSchema(), and (./react) React components' host trees into hoisted schemas with ports run by @exodra/react-compat.",
  "keywords": [
    "exodra",
    "babel",
    "babel-plugin",
    "jsx",
    "compiler",
    "schema",
    "ports",
    "hoisting"
  ],
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && mv dist/index.js dist/index.cjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "author": "Andrei Baikov",
  "license": "MIT",
  "homepage": "https://exodra.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/exodra.git",
    "directory": "packages/babel-plugin-exodra-schema"
  },
  "bugs": {
    "url": "https://github.com/abaikov/exodra/issues"
  },
  "dependencies": {
    "@babel/generator": "^7.24.0",
    "@babel/types": "^7.24.0",
    "@exodra/core": "^0.4.0",
    "@exodra/dom": "^0.4.0",
    "@exodra/react-compat": "^0.2.0",
    "@exodra/string": "^0.5.0",
    "jsdom": "^30.1.3"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.6.8"
  }
}
