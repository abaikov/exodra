{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@exodra/react-compat/names": ["../react-compat/dist/names.d.ts"],
      "@exodra/context": ["../context/dist/index.d.ts"],
      "@exodra/core": ["../core/dist/index.d.ts"],
      "@exodra/dom": ["../dom/dist/index.d.ts"],
      "@exodra/string": ["../string/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
