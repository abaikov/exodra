{
  // THE TEST FILES OF `@exodra/computed`. The scheme — why one of these per package, what each one
  // overrides and why `references` needs no handling — is written out once in
  // `packages/core/tsconfig.tests.json`.
  //
  // THIS PACKAGE. Its two suites reach the module under test by RELATIVE path and everything else
  // through `@exodra/core` and `@exodra/context` — the latter is a TEST-ONLY mapping, since `src/`
  // here names no context type at all. `extends` replaces the map wholesale rather than merging it,
  // which is why the base's entry appears again here and not by omission.
  // There is no `@exodra/computed` self-mapping because no suite imports this package by name.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false,
    "baseUrl": ".",
    "paths": {
      "@exodra/context": ["../context/.tsbuild/index.d.ts"],
      "@exodra/core": ["../core/.tsbuild/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", ".tsbuild", "node_modules"]
}
