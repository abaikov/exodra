{
  "name": "@exodra/dom",
  "version": "0.4.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/exodra.global.js",
  "jsdelivr": "./dist/exodra.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/exodra.esm.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "find src -name '*.js' -o -name '*.d.ts' -o -name '*.js.map' -o -name '*.d.ts.map' | xargs rm -f 2>/dev/null || true",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist .tsbuild tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:attr-setter": "tsx bench/exo-attr-setter-bench.ts"
  },
  "description": "Browser backend for Exodra schemas - each schema compiles once into a prototype element, a walk and a setter per port; an instance is a clone plus one call per port, and hydration adopts server-printed markup",
  "keywords": [
    "exodra",
    "dom",
    "renderer",
    "mount",
    "hydration",
    "ssr",
    "browser",
    "performance",
    "reactive-dom",
    "fine-grained",
    "typescript"
  ],
  "author": "Andrei Baikov",
  "license": "MIT",
  "homepage": "https://exodra.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/exodra.git",
    "directory": "packages/dom"
  },
  "bugs": {
    "url": "https://github.com/abaikov/exodra/issues"
  },
  "devDependencies": {
    "@exodra/computed": "^0.4.0",
    "@exodra/string": "^0.5.0",
    "jsdom": "^23.0.1",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "@exodra/context": "^0.3.0",
    "@exodra/core": "^0.4.0"
  }
}
