{
  "name": "@exodra/introspect",
  "version": "0.3.0",
  "description": "Static analysis for Exodra projects: an ESLint plugin and a ts-morph engine that counts components and reactive sources",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://exodra.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/exodra.git",
    "directory": "packages/introspect"
  },
  "bugs": {
    "url": "https://github.com/abaikov/exodra/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ts-morph": "^28.0.0",
    "glob": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "exodra",
    "introspection",
    "developer-tools",
    "static-analysis",
    "eslint-plugin",
    "code-analysis",
    "typescript"
  ],
  "author": "Andrei Baikov",
  "license": "MIT"
}
