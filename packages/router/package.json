{
    "name": "@exodra/router",
    "version": "0.4.1",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "unpkg": "./dist/exodra.global.js",
    "jsdelivr": "./dist/exodra.global.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./browser": {
            "types": "./dist/index.d.ts",
            "import": "./dist/exodra.esm.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prebuild": "find src -name '*.js' -o -name '*.d.ts' -o -name '*.js.map' -o -name '*.d.ts.map' | xargs rm -f 2>/dev/null || true",
        "build": "tsup",
        "prepublishOnly": "npm run build",
        "clean": "rm -rf dist .tsbuild tsconfig.tsbuildinfo",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "description": "Routing for Exodra: a plain route table, guards, lazy pages and query helpers — renderer-neutral matching plus a route boundary composed over a backend's child list",
    "keywords": [
        "exodra",
        "router",
        "routing",
        "file-based-routing",
        "nextjs",
        "spa",
        "navigation",
        "dynamic-routes",
        "nested-routes",
        "typescript",
        "reactive-router"
    ],
    "author": "Andrei Baikov",
    "license": "MIT",
    "homepage": "https://exodra.org",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/abaikov/exodra.git",
        "directory": "packages/router"
    },
    "bugs": {
        "url": "https://github.com/abaikov/exodra/issues"
    },
    "devDependencies": {
        "vitest": "^5.1.0"
    },
    "peerDependencies": {
        "@exodra/context": "^0.3.0",
        "@exodra/core": "^0.4.1"
    }
}
