{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    // NOT `dist` — see tsconfig.build.json. `dist` is tsup's, and is what gets published.
    "outDir": "./.tsbuild",
    "tsBuildInfoFile": "./.tsbuild/tsconfig.tsbuildinfo",
    "rootDir": "./src",
    // DOM is here for exactly ONE type and nothing else: `TExoEventHandler`, which the
    // connectors of ALL THREE backends take, has a closure form typed `(e: Event) => void`.
    // The server backend accepts a handler and prints nothing for it — but it has to be able
    // to NAME the type, or a component with a declarative handler would need a second wiring
    // function for the server, which is the whole thing the shared wire exists to prevent.
    // Nothing in this package touches a document, a node or a listener.
    "lib": ["ES2020", "DOM"],
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@exodra/context": ["../context/.tsbuild/index.d.ts"],
      "@exodra/core": ["../core/.tsbuild/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", ".tsbuild", "**/*.test.ts", "**/*.spec.ts", "**/bench/**"],
  "references": [
    { "path": "../context" },
    { "path": "../core" }
  ]
}
