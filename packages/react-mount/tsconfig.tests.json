{
  // THE TEST FILES OF `@exodra/react-mount`, COMPILED. The scheme is written out once in
  // `packages/core/tsconfig.tests.json`.
  //
  // `paths` restated in full (`extends` replaces it, never merges). `@exodra/string` and
  // `@exodra/test-utils` are added because the suite reaches for them directly.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false,
    "baseUrl": ".",
    "paths": {
      "@exodra/core": ["../core/.tsbuild/index.d.ts"],
      "@exodra/list-reconcile": ["../list-reconcile/.tsbuild/index.d.ts"],
      "@exodra/dom": ["../dom/.tsbuild/index.d.ts"],
      "@exodra/string": ["../string/.tsbuild/index.d.ts"],
      "@exodra/test-utils": ["../test-utils/.tsbuild/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", ".tsbuild", "node_modules"]
}
