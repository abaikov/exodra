{
    "name": "@exodra/react-mount",
    "version": "0.2.1",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "prepublishOnly": "npm run build",
        "clean": "rm -rf dist .tsbuild tsconfig.tsbuildinfo",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "@exodra/core": "^0.4.1",
        "@exodra/dom": "^0.4.1",
        "react": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tsup": "^9.0.0",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    },
    "author": "Andrei Baikov",
    "license": "MIT",
    "description": "Mount an Exodra tree inside a React app (islands, SSG-friendly hydration)",
    "homepage": "https://exodra.org",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/abaikov/exodra.git",
        "directory": "packages/react-mount"
    },
    "bugs": {
        "url": "https://github.com/abaikov/exodra/issues"
    },
    "keywords": [
        "exodra",
        "react",
        "island",
        "interop",
        "hydration",
        "adapter"
    ]
}
