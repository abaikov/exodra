  "scripts": {
    "typecheck": "tsc -b",
    "clean": "rm -rf .tsbuild tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@exodra/core": "^0.4.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.16"
  },
  "author": "Andrei Baikov",
  "license": "MIT",
  "homepage": "https://exodra.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/exodra.git",
    "directory": "packages/test-utils"
  },
  "bugs": {
    "url": "https://github.com/abaikov/exodra/issues"
  }
