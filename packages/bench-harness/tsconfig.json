{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "outDir": "./.tsbuild",
    "tsBuildInfoFile": "./.tsbuild/tsconfig.tsbuildinfo",
    "rootDir": "./src",
    "lib": ["ES2020", "DOM"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", ".tsbuild", "**/*.test.ts", "**/*.spec.ts"]
}
