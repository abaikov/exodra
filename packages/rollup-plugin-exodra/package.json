{
  "name": "rollup-plugin-exodra",
  "version": "0.2.0",
  "description": "Rollup plugin that compiles Exodra JSX (delegates to the canonical Babel pipeline)",
  "keywords": [
    "exodra",
    "rollup",
    "rollup-plugin",
    "jsx"
  ],
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && mv dist/index.js dist/index.cjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "author": "Andrei Baikov",
  "license": "MIT",
  "homepage": "https://exodra.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/exodra.git",
    "directory": "packages/rollup-plugin-exodra"
  },
  "bugs": {
    "url": "https://github.com/abaikov/exodra/issues"
  },
  "dependencies": {
    "babel-preset-exodra": "^0.2.0"
  },
  "peerDependencies": {
    "rollup": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "rollup": "^4.0.0"
  }
}
