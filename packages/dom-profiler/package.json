{
  "name": "@exodra/dom-profiler",
  "version": "0.2.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@exodra/core": "^0.4.0",
    "@exodra/dom": "^0.4.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "author": "Andrei Baikov",
  "license": "MIT",
  "description": "Performance profiling for the Exodra DOM renderer (works in the browser and under jsdom)",
  "homepage": "https://exodra.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/exodra.git",
    "directory": "packages/dom-profiler"
  },
  "bugs": {
    "url": "https://github.com/abaikov/exodra/issues"
  },
  "keywords": [
    "exodra",
    "profiler",
    "performance",
    "devtools",
    "dom",
    "jsdom"
  ]
}
