{
    "name": "@exodra/benchmarks",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "scripts": {
        "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "bench": "node scripts/run-benchmarks-headless.js",
        "axis": "node scripts/run-one-axis.js",
        "verify:structure": "node scripts/verify-structure.mjs",
        "check:build-modes": "node scripts/check-build-modes.mjs",
        "profile:app": "node scripts/profile-app.mjs",
        "profile:list-ops": "node scripts/profile-list-ops.mjs",
        "probe": "node scripts/probe-svelte.js",
        "detached-memory": "node scripts/detached-memory.mjs",
        "build:angular": "node bench/build/build-angular.mjs",
        "build:dom-bench": "esbuild dom-bench/entry.ts --bundle --format=esm --outfile=dom-bench/bundle.js",
        "dom-bench": "npm run build:dom-bench && node scripts/run-page.mjs dom-bench page.html",
        "build:participants": "npm run build:angular",
        "gate": "node scripts/compare-axis.mjs"
    },
    "dependencies": {
        "@exodra/babel-plugin-schema": "^0.1.0",
        "@exodra/computed": "^0.3.0",
        "@exodra/context": "^0.3.0",
        "@exodra/core": "^0.3.0",
        "@exodra/dom": "^0.3.0",
        "@exodra/forms": "^0.3.0",
        "@exodra/list-reconcile": "^0.3.0",
        "@exodra/react-compat": "^0.1.0",
        "@exodra/string": "^0.4.1",
        "@oimdb/core": "^3.12.1",
        "@oimdb/exodra": "^0.7.1",
        "jsdom": "^29.1.1",
        "lit": "^3.3.3",
        "marko": "^6.1.8",
        "mikado": "^0.8.400",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "solid-js": "^1.8.7",
        "svelte": "^5.56.8"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@builder.io/qwik": "^1.20.0",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@types/node": "^20.10.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "esbuild": "^0.27.7",
        "million": "^3.1.11",
        "oby": "^15.1.2",
        "playwright": "^1.62.0",
        "preact": "^11.1.1",
        "sinuous": "^0.32.1",
        "stage0": "^0.0.25",
        "typescript": "^5.3.3",
        "uhtml": "^5.0.9",
        "vite": "^7.3.0",
        "vite-plugin-solid": "^2.11.10",
        "voby": "^0.58.1"
    }
}
