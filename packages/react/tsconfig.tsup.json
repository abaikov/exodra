{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    // The bundler's directory, stated here so it does not follow the typecheck's
    // `.tsbuild` (see tsconfig.build.json).
    "outDir": "./dist",
    // The dependencies' PUBLISHED bundles, produced earlier in `npm run build`'s order —
    // which is the input tsup's `dts` pass legitimately consumes. Restated here in full
    // because the typecheck config this extends points every one of them at `.tsbuild`.
    "paths": {
      "@exodra/core": ["../core/dist/index.d.ts"],
      "@exodra/dom": ["../dom/dist/index.d.ts"],
      "@exodra/string": ["../string/dist/index.d.ts"]
    }
  },
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
