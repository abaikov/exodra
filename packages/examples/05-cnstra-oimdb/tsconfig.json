{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@exodra/jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      // @exodra/jsx is published on npm at the SAME version as this workspace, so
      // npm nests the stale published copy in this example's node_modules. Pin the
      // JSX type resolution to the local workspace so event-handler inference (LMA)
      // and ExoEvent/ExoInputEvent reflect the current source, not published 0.1.0.
      "@exodra/jsx": [
        "../../jsx/dist/index.d.ts"
      ],
      "@exodra/jsx/jsx-runtime": [
        "../../jsx/dist/jsx-runtime.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
