{
  // The scheme — why one of these per package, what each one overrides and why `references` needs
  // no handling — is written out once in `packages/core/tsconfig.tests.json`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", ".tsbuild", "node_modules"]
}
