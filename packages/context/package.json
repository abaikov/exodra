{
  "name": "@exodra/context",
  "version": "0.3.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "find src -name '*.js' -o -name '*.d.ts' -o -name '*.js.map' -o -name '*.d.ts.map' | xargs rm -f 2>/dev/null || true",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist .tsbuild tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:context": "tsx bench/exo-context-bench.ts"
  },
  "description": "The context chain for Exodra backends - an immutable frame per provide, a token compared by identity, and the walk that reads one",
  "keywords": [
    "exodra",
    "context",
    "dependency-injection",
    "provide",
    "inject",
    "fine-grained",
    "performance",
    "typescript"
  ],
  "author": "Andrei Baikov",
  "license": "MIT",
  "homepage": "https://exodra.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/exodra.git",
    "directory": "packages/context"
  },
  "bugs": {
    "url": "https://github.com/abaikov/exodra/issues"
  },
  "devDependencies": {
    "@exodra/bench-harness": "*",
    "vitest": "^4.0.16"
  }
}
